#version 460
#extension GL_EXT_control_flow_attributes: enable

// Shared-memory FP32 GEMM with configurable per-invocation register blocking.
//
// Workgroup output block: block_m x block_p.
// K block: block_n.
// Local size: (block_m / thread_tile_m) x (block_p / thread_tile_p).
layout(constant_id = 0) const uint block_m = 64;
layout(constant_id = 1) const uint block_n = 16;
layout(constant_id = 2) const uint block_p = 64;
layout(constant_id = 3) const uint local_m_cnt = 16;
layout(constant_id = 4) const uint local_p_cnt = 16;
layout(constant_id = 5) const uint thread_tile_m = 4;
layout(constant_id = 6) const uint thread_tile_p = 4;
layout(local_size_x_id = 3, local_size_y_id = 4, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly restrict buffer tensor_a {
    float a[];
};

layout(set = 0, binding = 1) readonly restrict buffer tensor_b {
    float b[];
};

layout(set = 0, binding = 2) restrict buffer tensor_c {
    float c[];
};

layout(push_constant) uniform constants {
    uint batch;
    uint m;
    uint n;
    uint p;
    float alpha;
    float beta;
    uint a_stride;
    uint b_stride;
    uint c_stride;
    uint a_m_stride;
    uint a_n_stride;
    uint b_n_stride;
    uint b_p_stride;
    uint c_m_stride;
    uint c_p_stride;
} args;

const uint thread_accum_count = thread_tile_m * thread_tile_p;
const bool can_swizzle_tile_a = (block_m & (block_m - 1)) == 0;
const uint tile_a_swizzle_mask = block_m < 32 ? block_m - 1 : 31;

shared float tile_a[block_n][block_m];
shared float tile_b[block_n][block_p];

uint get_a_idx(uint batch_id, uint r, uint col) {
    return batch_id * args.a_stride + r * args.a_m_stride + col * args.a_n_stride;
}

uint get_b_idx(uint batch_id, uint r, uint col) {
    return batch_id * args.b_stride + r * args.b_n_stride + col * args.b_p_stride;
}

uint get_c_idx(uint batch_id, uint r, uint col) {
    return batch_id * args.c_stride + r * args.c_m_stride + col * args.c_p_stride;
}

uint get_tile_a_row(uint row, uint n_offset) {
    // XOR only changes the shared-memory bank; global A loads remain contiguous.
    return can_swizzle_tile_a
        ? row ^ (n_offset & tile_a_swizzle_mask)
        : row;
}

void update_c(uint c_idx, float value) {
    if(args.beta == 0.0) {
        c[c_idx] = args.alpha == 1.0 ? value : args.alpha * value;
    } else {
        c[c_idx] = fma(args.alpha, value, args.beta * c[c_idx]);
    }
}

void main() {
    const uint batch_id = gl_WorkGroupID.x;
    const uint block_m_id = gl_WorkGroupID.y;
    const uint block_p_id = gl_WorkGroupID.z;

    const uint local_m = gl_LocalInvocationID.x;
    const uint local_p = gl_LocalInvocationID.y;
    const uint local_id = local_p * local_m_cnt + local_m;
    const uint local_count = local_m_cnt * local_p_cnt;

    const uint block_col_base = local_p * thread_tile_p;
    const uint global_col_base = block_p_id * block_p + block_col_base;
    const uint tiled_n_cnt = (args.n / block_n) + (args.n % block_n == 0 ? 0 : 1);

    float acc[thread_accum_count];
    [[unroll]]
    for(uint i = 0; i < thread_accum_count; i++) {
        acc[i] = 0.0;
    }

    for(uint block_n_id = 0; block_n_id < tiled_n_cnt; block_n_id++) {
        for(uint load_idx = local_id; load_idx < block_m * block_n; load_idx += local_count) {
            const uint load_m = load_idx / block_n;
            const uint load_n = load_idx % block_n;
            const uint a_r = block_m_id * block_m + load_m;
            const uint a_c = block_n_id * block_n + load_n;

            tile_a[load_n][get_tile_a_row(load_m, load_n)] =
                (a_r < args.m && a_c < args.n) ? a[get_a_idx(batch_id, a_r, a_c)] : 0.0;
        }

        for(uint load_idx = local_id; load_idx < block_n * block_p; load_idx += local_count) {
            const uint load_n = load_idx / block_p;
            const uint load_p = load_idx % block_p;
            const uint b_r = block_n_id * block_n + load_n;
            const uint b_c = block_p_id * block_p + load_p;

            tile_b[load_n][load_p] =
                (b_r < args.n && b_c < args.p) ? b[get_b_idx(batch_id, b_r, b_c)] : 0.0;
        }

        barrier();

        for(uint n_offset = 0; n_offset < block_n; n_offset++) {
            float b_vals[thread_tile_p];

            [[unroll]]
            for(uint c_col = 0; c_col < thread_tile_p; c_col++) {
                b_vals[c_col] = tile_b[n_offset][block_col_base + c_col];
            }

            // Every K step forms a scalar register-tile outer product.
            [[unroll]]
            for(uint r = 0; r < thread_tile_m; r++) {
                const uint block_row = local_m + r * local_m_cnt;
                const float a_val = tile_a[n_offset][get_tile_a_row(block_row, n_offset)];
                [[unroll]]
                for(uint c_col = 0; c_col < thread_tile_p; c_col++) {
                    const uint acc_idx = r * thread_tile_p + c_col;
                    acc[acc_idx] = fma(a_val, b_vals[c_col], acc[acc_idx]);
                }
            }
        }

        if(block_n_id + 1 < tiled_n_cnt) {
            barrier();
        }
    }

    [[unroll]]
    for(uint r = 0; r < thread_tile_m; r++) {
        const uint block_row = local_m + r * local_m_cnt;
        const uint global_r = block_m_id * block_m + block_row;
        if(global_r >= args.m) {
            continue;
        }

        [[unroll]]
        for(uint c_col = 0; c_col < thread_tile_p; c_col++) {
            const uint global_c = global_col_base + c_col;
            if(global_c >= args.p) {
                continue;
            }

            const uint acc_idx = r * thread_tile_p + c_col;
            const uint c_idx = get_c_idx(batch_id, global_r, global_c);
            update_c(c_idx, acc[acc_idx]);
        }
    }
}
